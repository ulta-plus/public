    "connectivity_check_config": {
        "version": 1,
        "phase1TimeoutMs": 5000,
        "phase2TimeoutMs": 5000,
        "variables": {
            "DEVICE_ID": "{{DEVICE_ID}}"
        },
        "steps": [
            {
                "id": "check-get-country",
                "group": "A",
                "type": "http_request",
                "payload": {
                    "url": "https://api.ubst.space/client-api/v1/get-country",
                    "method": "GET",
                    "timeoutMs": 5000
                }
            },
            {
                "id": "check-download-awg-key",
                "group": "A",
                "type": "http_request",
                "payload": {
                    "url": "https://api.ubst.space/api/v1/wg_keys/download?key_type=youtube",
                    "method": "GET",
                    "headers": {
                        "X-Device-ID": "{{DEVICE_ID}}",
                        "Accept": "application/json"
                    },
                    "timeoutMs": 5000
                }
            },
            {
