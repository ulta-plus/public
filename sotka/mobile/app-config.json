{
    "api_base_url": "https://api.stkv.space",
    "default_vpn_protocol": "AWG",
    "tg_bot": "sotka_install_bot",
    "tg_key_bot": "sotka_install_bot",
    "vpn_connections": [
        {
            "country_code": "*",
            "title": "Весь интернет",
            "configuration_url": null,
            "vpn_type": "wg",
            "is_api_basic_auth_enabled": false,
            "relative_path": "client-api/v1/download-awg-key",
            "anonymous_relative_path": "client-api/v1/download-anonymous-key",
            "relative_path_vless": "vless-api/v1/download-vless-key",
            "anonymous_relative_path_vless": "vless-api/v1/download-anonymous-vless-key"
        }
    ],
    "privacy_policy_url": "https://storage.googleapis.com/sotka/docs/privacy_policy.html",
    "tos_url": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/",
    "is_vpn_protocol_selector_enabled": false,
    "is_no_key_button_visible": false,
    "is_smart_routing_enabled": true,
    "is_mobile_free_mode_v1_enabled": false,
    "support_chat_url": "https://sotka.cloud/support",
    "hybrid_storefront_country_codes": ["*"],
    "hybrid_storefront_geo_ip_country_codes": ["*"],
    "is_whitelist_alert_enabled": true,
    "whitelist_alert_foreground_interval_minutes": 30,
    "whitelist_alert_url": "https://storage.yandexcloud.net/vpnn-web-configs/sotka/BC/sotka.html",
    "connectivity_check_config": {
        "version": 1,
        "phase1TimeoutMs": 5000,
        "phase2TimeoutMs": 5000,
        "variables": {
            "DEVICE_ID": "{{DEVICE_ID}}"
        },
        "steps": [
            {
                "id": "check-get-country",
                "group": "A",
                "type": "http_request",
                "payload": {
                    "url": "{{API_BASE_URL}}/client-api/v1/get-country",
                    "method": "GET",
                    "timeoutMs": 5000,
                    "acceptAnyStatus": true
                }
            },
            {
                "id": "check-google",
                "group": "B",
                "type": "http_request",
                "payload": {
                    "url": "https://www.google.com",
                    "method": "GET",
                    "timeoutMs": 5000,
                    "acceptAnyStatus": true
                }
            },
            {
                "id": "check-wikipedia",
                "group": "B",
                "type": "http_request",
                "payload": {
                    "url": "https://www.wikipedia.org",
                    "method": "GET",
                    "timeoutMs": 5000,
                    "acceptAnyStatus": true
                }
            },
            {
                "id": "check-ya",
                "group": "C",
                "type": "http_request",
                "payload": {
                    "url": "https://ya.ru",
                    "method": "GET",
                    "timeoutMs": 5000,
                    "acceptAnyStatus": true
                }
            },
            {
                "id": "check-vk",
                "group": "C",
                "type": "http_request",
                "payload": {
                    "url": "https://eh.vk.com",
                    "method": "GET",
                    "timeoutMs": 5000,
                    "acceptAnyStatus": true
                }
            },
            {
                "id": "check-max",
                "group": "C",
                "type": "http_request",
                "payload": {
                    "url": "https://web.max.ru",
                    "method": "GET",
                    "timeoutMs": 5000,
                    "acceptAnyStatus": true
                }
            },
            {
                "id": "check-yandex-taxi",
                "group": "C",
                "type": "http_request",
                "payload": {
                    "url": "https://taxi.yandex.ru",
                    "method": "GET",
                    "timeoutMs": 5000,
                    "acceptAnyStatus": true
                }
            }
        ]
    }
}
